# Safe template only. Do not add real API keys or private keys to GitHub.
# Frontend Firebase SDK config is currently loaded from firebase-applet-config.json.

# Firebase Admin (required for authenticated server API routes)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional Firebase Storage bucket
FIREBASE_STORAGE_BUCKET=

# Cashfree payment gateway (server-only credentials)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Use "sandbox" for testing or "production" for live Cashfree credentials
CASHFREE_ENV=
CASHFREE_API_VERSION=

# Public browser payment mode; must match the backend Cashfree environment
VITE_CASHFREE_ENV=

# Absolute public website URL, e.g. https://satyaeducation.in
APP_URL=
