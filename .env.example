# ============================================================================
# SATYA'S EDUCATION — ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# IMPORTANT:
# - Frontend variables exposed to Vite React MUST start with VITE_
# - Do NOT mix Next.js NEXT_PUBLIC_ conventions with Vite VITE_ conventions.
# - Server-only secrets (Firebase Admin, Cashfree Secret Key) MUST NEVER start
#   with VITE_ and must never be imported in browser code.
# - Public Firebase client configuration is loaded from firebase-applet-config.json.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Browser-Safe)
# ----------------------------------------------------------------------------
# Public Cashfree Environment Mode for JS Checkout SDK ("sandbox" or "production")
VITE_CASHFREE_ENV="sandbox"

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY FIREBASE ADMIN SDK CREDENTIALS (Backend Only — Never Expose)
# ----------------------------------------------------------------------------
# Used by Express/Vercel serverless routes (/api/*) and the one-time admin
# bootstrap script (scripts/grant-admin.ts) & Django backend.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Replace literal newlines with \n when pasting into Vercel Environment Variables
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# ----------------------------------------------------------------------------
# 3. SERVER-ONLY CASHFREE PAYMENT GATEWAY SECRETS (Backend Only — INR)
# ----------------------------------------------------------------------------
# Obtain from Cashfree Merchant Dashboard -> Developers -> API Keys
# Cashfree uses CASHFREE_SECRET_KEY to compute HMAC-SHA256 webhook signatures
# (x-webhook-timestamp + rawBody). No separate webhook secret is needed.
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2023-08-01"

# ----------------------------------------------------------------------------
# 4. APPLICATION & RUNTIME URLS
# ----------------------------------------------------------------------------
APP_URL="http://localhost:3000"
GEMINI_API_KEY=""
