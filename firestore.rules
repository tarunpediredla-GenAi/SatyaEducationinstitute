rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Cost-safe admin check (no DB lookup) for list operations
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'tarunpediredla9966@gmail.com';
    }

    // Full admin check for single-document operations
    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'tarunpediredla9966@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 30 &&
        data.role is string && data.role.size() <= 20 && (data.role == 'student' || data.role == 'admin') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'description', 'group', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'description', 'group', 'active', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.group is string && data.group.size() <= 30 && (data.group == 'technology' || data.group == 'books' || data.group == 'storybooks') &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'title', 'slug', 'type', 'category', 'priceInr', 'originalPriceInr',
          'language', 'format', 'stock', 'featured', 'status', 'authorOrInstructor',
          'shortDescription', 'description', 'coverType', 'level', 'duration',
          'previewVideoUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'slug', 'type', 'category', 'priceInr', 'originalPriceInr',
          'language', 'format', 'stock', 'featured', 'status', 'authorOrInstructor',
          'shortDescription', 'description', 'coverType', 'level', 'duration',
          'previewVideoUrl', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 160 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.type is string && data.type.size() <= 30 && (data.type == 'course' || data.type == 'book' || data.type == 'storybook') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.priceInr is int && data.priceInr >= 0 && data.priceInr <= 500000 &&
        data.originalPriceInr is int && data.originalPriceInr >= 0 && data.originalPriceInr <= 500000 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 60 &&
        data.format is string && data.format.size() <= 40 && (
          data.format == 'recorded_course' || data.format == 'digital_book' ||
          data.format == 'physical_book' || data.format == 'hybrid_book'
        ) &&
        data.stock is int && data.stock >= 0 && data.stock <= 100000 &&
        data.featured is bool &&
        data.status is string && data.status.size() <= 30 && (
          data.status == 'published' || data.status == 'draft' || data.status == 'archived'
        ) &&
        data.authorOrInstructor is string && data.authorOrInstructor.size() >= 2 && data.authorOrInstructor.size() <= 120 &&
        data.shortDescription is string && data.shortDescription.size() >= 5 && data.shortDescription.size() <= 600 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 4000 &&
        data.coverType is string && data.coverType.size() >= 1 && data.coverType.size() <= 60 &&
        data.level is string && data.level.size() >= 1 && data.level.size() <= 60 &&
        data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 60 &&
        data.previewVideoUrl is string && data.previewVideoUrl.size() >= 0 && data.previewVideoUrl.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCourseDetails(data) {
      return data.keys().hasAll([
          'id', 'productId', 'title', 'instructor', 'language', 'level',
          'duration', 'introduction', 'syllabusSummary', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'productId', 'title', 'instructor', 'language', 'level',
          'duration', 'introduction', 'syllabusSummary', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.instructor is string && data.instructor.size() >= 2 && data.instructor.size() <= 120 &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 60 &&
        data.level is string && data.level.size() >= 2 && data.level.size() <= 60 &&
        data.duration is string && data.duration.size() >= 2 && data.duration.size() <= 60 &&
        data.introduction is string && data.introduction.size() >= 5 && data.introduction.size() <= 3000 &&
        data.syllabusSummary is string && data.syllabusSummary.size() >= 5 && data.syllabusSummary.size() <= 4000 &&
        data.status is string && data.status.size() <= 30 && (
          data.status == 'published' || data.status == 'draft' || data.status == 'archived'
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLesson(data) {
      return data.keys().hasAll([
          'id', 'courseId', 'moduleTitle', 'title', 'orderIndex',
          'durationMinutes', 'isFreePreview', 'videoStoragePath', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'courseId', 'moduleTitle', 'title', 'orderIndex',
          'durationMinutes', 'isFreePreview', 'videoStoragePath', 'notes',
          'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.moduleTitle is string && data.moduleTitle.size() >= 2 && data.moduleTitle.size() <= 160 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.orderIndex is int && data.orderIndex >= 0 && data.orderIndex <= 1000 &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
        data.isFreePreview is bool &&
        data.videoStoragePath is string && data.videoStoragePath.size() >= 1 && data.videoStoragePath.size() <= 500 &&
        data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 3000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'userId', 'customerName', 'customerEmail', 'totalAmountInr',
          'paymentStatus', 'shipmentStatus', 'cashfreeOrderId', 'cashfreePaymentId',
          'hasPhysicalItems', 'shippingAddressSummary', 'itemSummary', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'customerName', 'customerEmail', 'totalAmountInr',
          'paymentStatus', 'shipmentStatus', 'cashfreeOrderId', 'cashfreePaymentId',
          'hasPhysicalItems', 'shippingAddressSummary', 'itemSummary', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 256 &&
        data.totalAmountInr is int && data.totalAmountInr >= 0 && data.totalAmountInr <= 10000000 &&
        data.paymentStatus is string && data.paymentStatus.size() <= 30 && (
          data.paymentStatus == 'pending' || data.paymentStatus == 'paid' ||
          data.paymentStatus == 'failed' || data.paymentStatus == 'cancelled' ||
          data.paymentStatus == 'refunded'
        ) &&
        data.shipmentStatus is string && data.shipmentStatus.size() <= 30 && (
          data.shipmentStatus == 'not_applicable' || data.shipmentStatus == 'processing' ||
          data.shipmentStatus == 'packed' || data.shipmentStatus == 'shipped' ||
          data.shipmentStatus == 'delivered'
        ) &&
        data.cashfreeOrderId is string && data.cashfreeOrderId.size() >= 1 && data.cashfreeOrderId.size() <= 128 &&
        data.cashfreePaymentId is string && data.cashfreePaymentId.size() >= 0 && data.cashfreePaymentId.size() <= 128 &&
        data.hasPhysicalItems is bool &&
        data.shippingAddressSummary is string && data.shippingAddressSummary.size() >= 0 && data.shippingAddressSummary.size() <= 600 &&
        data.itemSummary is string && data.itemSummary.size() >= 2 && data.itemSummary.size() <= 1500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEntitlement(data) {
      return data.keys().hasAll([
          'id', 'userId', 'productId', 'productType', 'orderId', 'downloadPath', 'grantedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'productId', 'productType', 'orderId', 'downloadPath', 'grantedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productType is string && data.productType.size() <= 30 && (
          data.productType == 'course' || data.productType == 'book' || data.productType == 'storybook'
        ) &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 && data.orderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.downloadPath is string && data.downloadPath.size() >= 0 && data.downloadPath.size() <= 500 &&
        data.grantedAt is timestamp;
    }

    function isValidLessonProgress(data) {
      return data.keys().hasAll([
          'id', 'userId', 'courseId', 'lessonId', 'completed', 'watchedSeconds', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'courseId', 'lessonId', 'completed', 'watchedSeconds', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.courseId is string && data.courseId.size() >= 1 && data.courseId.size() <= 128 && data.courseId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.lessonId is string && data.lessonId.size() >= 1 && data.lessonId.size() <= 128 && data.lessonId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.completed is bool &&
        data.watchedSeconds is int && data.watchedSeconds >= 0 && data.watchedSeconds <= 36000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWishlistItem(data) {
      return data.keys().hasAll(['id', 'userId', 'productId', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'productId', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    function isValidDeliveryAddress(data) {
      return data.keys().hasAll([
          'id', 'userId', 'fullName', 'phone', 'line1', 'line2',
          'city', 'state', 'postalCode', 'isDefault', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userId', 'fullName', 'phone', 'line1', 'line2',
          'city', 'state', 'postalCode', 'isDefault', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30 &&
        data.line1 is string && data.line1.size() >= 3 && data.line1.size() <= 200 &&
        data.line2 is string && data.line2.size() >= 0 && data.line2.size() <= 200 &&
        data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
        data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
        data.postalCode is string && data.postalCode.size() >= 4 && data.postalCode.size() <= 20 &&
        data.isDefault is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBanner(data) {
      return data.keys().hasAll([
          'id', 'title', 'subtitle', 'ctaText', 'ctaLink',
          'couponCode', 'discountPercent', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'subtitle', 'ctaText', 'ctaLink',
          'couponCode', 'discountPercent', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.subtitle is string && data.subtitle.size() >= 2 && data.subtitle.size() <= 300 &&
        data.ctaText is string && data.ctaText.size() >= 2 && data.ctaText.size() <= 60 &&
        data.ctaLink is string && data.ctaLink.size() >= 1 && data.ctaLink.size() <= 200 &&
        data.couponCode is string && data.couponCode.size() >= 0 && data.couponCode.size() <= 40 &&
        data.discountPercent is int && data.discountPercent >= 0 && data.discountPercent <= 90 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        incoming().uid == adminId && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedBy']);
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid && incoming().uid == userId &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (incoming().role == 'student' || isBootstrappedAdmin());
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'updatedAt'])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (resource.data.active == true || isAdmin());
      allow list: if resource.data.active == true || isBootstrappedAdmin();
      allow create: if isValidId(categoryId) && isValidCategory(incoming()) && isAdmin() &&
        incoming().id == categoryId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(categoryId) && isValidCategory(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'description', 'group', 'active', 'updatedAt']);
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isBootstrappedAdmin();
      allow create: if isValidId(productId) && isValidProduct(incoming()) && isAdmin() &&
        incoming().id == productId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(productId) && isValidProduct(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'slug', 'type', 'category', 'priceInr', 'originalPriceInr',
          'language', 'format', 'stock', 'featured', 'status', 'authorOrInstructor',
          'shortDescription', 'description', 'coverType', 'level', 'duration',
          'previewVideoUrl', 'updatedAt'
        ]);
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId) && (resource.data.status == 'published' || isAdmin());
      allow list: if resource.data.status == 'published' || isBootstrappedAdmin();
      allow create: if isValidId(courseId) && isValidCourseDetails(incoming()) && isAdmin() &&
        incoming().id == courseId && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isValidId(courseId) && isValidCourseDetails(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().productId == existing().productId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'instructor', 'language', 'level', 'duration',
          'introduction', 'syllabusSummary', 'status', 'updatedAt'
        ]);
      allow delete: if isValidId(courseId) && isAdmin();
    }

    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && (
        resource.data.isFreePreview == true ||
        isAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/entitlements/$(request.auth.uid + '_' + resource.data.courseId)))
      );
      allow list: if resource.data.isFreePreview == true || isBootstrappedAdmin();
      allow create: if isValidId(lessonId) && isValidLesson(incoming()) && isAdmin() &&
        incoming().id == lessonId && incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId));
      allow update: if isValidId(lessonId) && isValidLesson(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().courseId == existing().courseId &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'moduleTitle', 'title', 'orderIndex', 'durationMinutes',
          'isFreePreview', 'videoStoragePath', 'notes', 'updatedAt'
        ]);
      allow delete: if isValidId(lessonId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isVerifiedUser() && isValidId(orderId) && isValidOrder(incoming()) &&
        incoming().id == orderId &&
        incoming().userId == request.auth.uid &&
        incoming().paymentStatus == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && (
        isAdmin() || (
          isVerifiedUser() &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          incoming().totalAmountInr == existing().totalAmountInr &&
          incoming().createdAt == existing().createdAt &&
          existing().paymentStatus == 'pending' &&
          incoming().paymentStatus == 'cancelled' &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt'])
        )
      );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /entitlements/{entitlementId} {
      allow get: if isSignedIn() && isValidId(entitlementId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isValidId(entitlementId) && isValidEntitlement(incoming()) && isAdmin() &&
        incoming().id == entitlementId && incoming().grantedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().userId)) &&
        exists(/databases/$(database)/documents/products/$(incoming().productId)) &&
        exists(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update: if isValidId(entitlementId) && isValidEntitlement(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().userId == existing().userId &&
        incoming().productId == existing().productId && incoming().orderId == existing().orderId &&
        incoming().grantedAt == existing().grantedAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['downloadPath']);
      allow delete: if isValidId(entitlementId) && isAdmin();
    }

    match /progress/{progressId} {
      allow get: if isSignedIn() && isValidId(progressId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isVerifiedUser() && isValidId(progressId) && isValidLessonProgress(incoming()) &&
        incoming().id == progressId && incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/courses/$(incoming().courseId)) &&
        exists(/databases/$(database)/documents/lessons/$(incoming().lessonId));
      allow update: if isSignedIn() && isValidId(progressId) && isValidLessonProgress(incoming()) && (
        isAdmin() || (
          isVerifiedUser() &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          incoming().courseId == existing().courseId &&
          incoming().lessonId == existing().lessonId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'watchedSeconds', 'updatedAt'])
        )
      );
      allow delete: if isSignedIn() && isValidId(progressId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /wishlists/{wishlistId} {
      allow get: if isSignedIn() && isValidId(wishlistId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isVerifiedUser() && isValidId(wishlistId) && isValidWishlistItem(incoming()) &&
        incoming().id == wishlistId && incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isSignedIn() && isValidId(wishlistId) && isValidWishlistItem(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['productId']);
      allow delete: if isSignedIn() && isValidId(wishlistId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /addresses/{addressId} {
      allow get: if isSignedIn() && isValidId(addressId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isBootstrappedAdmin();
      allow create: if isVerifiedUser() && isValidId(addressId) && isValidDeliveryAddress(incoming()) &&
        incoming().id == addressId && incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isSignedIn() && isValidId(addressId) && isValidDeliveryAddress(incoming()) && (
        isAdmin() || (
          isVerifiedUser() &&
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().id == existing().id &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'fullName', 'phone', 'line1', 'line2', 'city', 'state', 'postalCode', 'isDefault', 'updatedAt'
          ])
        )
      );
      allow delete: if isSignedIn() && isValidId(addressId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /banners/{bannerId} {
      allow get: if isValidId(bannerId) && (resource.data.active == true || isAdmin());
      allow list: if resource.data.active == true || isBootstrappedAdmin();
      allow create: if isValidId(bannerId) && isValidBanner(incoming()) && isAdmin() &&
        incoming().id == bannerId && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(bannerId) && isValidBanner(incoming()) && isAdmin() &&
        incoming().id == existing().id && incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'ctaText', 'ctaLink', 'couponCode', 'discountPercent', 'active', 'updatedAt'
        ]);
      allow delete: if isValidId(bannerId) && isAdmin();
    }
  }
}
