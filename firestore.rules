rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (request.auth.token.email == "tarunpediredla9966@gmail.com" && request.auth.token.email_verified == true) ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'role', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'role', 'updatedAt']) &&
        data.uid is string && data.uid == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.role in ['student', 'admin'] &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidStorageAsset(data, assetId) {
      return data.keys().hasAll(['id', 'fileName', 'storagePath', 'downloadUrl', 'contentType', 'sizeBytes', 'uploadedByUid', 'createdAt']) &&
        data.keys().hasOnly(['id', 'fileName', 'storagePath', 'downloadUrl', 'contentType', 'sizeBytes', 'uploadedByUid', 'createdAt']) &&
        data.id is string && data.id == assetId &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 256 &&
        data.storagePath is string && data.storagePath.size() >= 1 && data.storagePath.size() <= 512 &&
        data.downloadUrl is string && data.downloadUrl.size() >= 1 && data.downloadUrl.size() <= 2048 &&
        data.contentType is string && data.contentType.size() >= 1 && data.contentType.size() <= 128 &&
        data.sizeBytes is number && data.sizeBytes >= 0 && data.sizeBytes <= 524288000 &&
        data.uploadedByUid is string && data.uploadedByUid == request.auth.uid &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidOrderRecord(data, orderId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'customerName',
          'customerEmail',
          'totalAmountInr',
          'paymentStatus',
          'shipmentStatus',
          'paymentReference',
          'hasPhysicalItems',
          'shippingAddressSummary',
          'itemSummary',
          'lineItems',
          'entitlementsGranted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'userId',
          'customerName',
          'customerEmail',
          'totalAmountInr',
          'paymentStatus',
          'shipmentStatus',
          'paymentReference',
          'hasPhysicalItems',
          'shippingAddressSummary',
          'itemSummary',
          'lineItems',
          'entitlementsGranted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id == orderId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 256 &&
        data.totalAmountInr is number && data.totalAmountInr >= 0 && data.totalAmountInr <= 10000000 &&
        data.paymentStatus in ['pending', 'paid', 'failed', 'refunded'] &&
        data.shipmentStatus in ['not_applicable', 'processing', 'packed', 'shipped', 'delivered'] &&
        data.paymentReference is string && data.paymentReference.size() <= 256 &&
        data.hasPhysicalItems is bool &&
        data.shippingAddressSummary is string && data.shippingAddressSummary.size() <= 600 &&
        data.itemSummary is string && data.itemSummary.size() <= 1500 &&
        data.lineItems is list && data.lineItems.size() >= 1 && data.lineItems.size() <= 50 &&
        data.entitlementsGranted is bool &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidEntitlementRecord(data, entitlementId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'productId',
          'productType',
          'orderId',
          'downloadPath',
          'grantedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'userId',
          'productId',
          'productType',
          'orderId',
          'downloadPath',
          'grantedAt'
        ]) &&
        data.id is string && data.id == entitlementId &&
        data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 &&
        data.productType in ['course', 'book', 'storybook'] &&
        data.orderId is string && data.orderId.size() >= 1 && data.orderId.size() <= 128 &&
        data.downloadPath is string && data.downloadPath.size() >= 1 && data.downloadPath.size() <= 512 &&
        data.grantedAt is string && data.grantedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) &&
        isValidUserProfile(request.resource.data, userId) &&
        ((isOwner(userId) && request.resource.data.role == 'student') || isAdmin());
      allow update: if isValidId(userId) &&
        isValidUserProfile(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        ((isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Restrict storageAssets metadata strictly to authorized administrators
    match /storageAssets/{assetId} {
      allow get: if isValidId(assetId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(assetId) && isAdmin() && isValidStorageAsset(request.resource.data, assetId);
      allow update: if isValidId(assetId) &&
        isAdmin() &&
        isValidStorageAsset(request.resource.data, assetId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(assetId) && isAdmin();
    }

    // Customer Orders: Customers can only read their own orders.
    // Order creation, payment status updates, and deletions are forbidden from customer client tokens
    // and are performed exclusively on the backend using trusted Firebase Service Account credentials.
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && ((isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin());
      allow list: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(orderId) && isAdmin() && isValidOrderRecord(request.resource.data, orderId);
      allow update: if isValidId(orderId) &&
        isAdmin() &&
        isValidOrderRecord(request.resource.data, orderId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.totalAmountInr == resource.data.totalAmountInr &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Course & Book Entitlements: Customers can only read their own entitlements.
    // Customers can NEVER create, update, or delete entitlements from client tokens;
    // entitlements are granted exclusively by server-side service-account credentials.
    match /entitlements/{entitlementId} {
      allow get: if isValidId(entitlementId) && ((isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin());
      allow list: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update: if isValidId(entitlementId) &&
        isAdmin() &&
        isValidEntitlementRecord(request.resource.data, entitlementId);
      allow delete: if isValidId(entitlementId) && isAdmin();
    }
  }
}
