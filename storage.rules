rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "tarunpediredla9966@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.resource.size < 100 * 1024 * 1024;
    }

    match /protected/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.resource.size < 500 * 1024 * 1024;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.size < 50 * 1024 * 1024;
    }
  }
}
