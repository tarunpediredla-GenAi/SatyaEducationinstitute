rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'tarunpediredla9966@gmail.com' ||
          request.auth.token.admin == true ||
          firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        );
    }

    function hasEntitlement(productId) {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/entitlements/$(request.auth.uid + '_' + productId));
    }

    // 1. Public Product Covers & Course Preview Thumbnails (Read-only public, Admin upload with type/size checks)
    match /public/covers/{fileName} {
      allow read: if true;
      allow write: if isVerifiedAdmin() &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
    }

    // 2. Public Free Preview Lesson Videos (Max 100MB MP4/WebM)
    match /public/previews/{courseId}/{fileName} {
      allow read: if true;
      allow write: if isVerifiedAdmin() &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType.matches('video/(mp4|webm)');
    }

    // 3. Protected Course Recordings (Requires verified purchase entitlement or Admin; Max 500MB video)
    match /protected/courses/{courseId}/{lessonFile} {
      allow read: if hasEntitlement(courseId) || isVerifiedAdmin();
      allow write: if isVerifiedAdmin() &&
        request.resource.size <= 500 * 1024 * 1024 &&
        request.resource.contentType.matches('video/(mp4|webm)');
    }

    // 4. Protected Digital Books & Storybooks (Requires verified purchase entitlement or Admin; Max 50MB PDF/EPUB)
    match /protected/books/{productId}/{bookFile} {
      allow read: if hasEntitlement(productId) || isVerifiedAdmin();
      allow write: if isVerifiedAdmin() &&
        request.resource.size <= 50 * 1024 * 1024 &&
        (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/epub+zip'
        );
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
